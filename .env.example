# Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Session security
SESSION_SECRET=your-secure-random-session-secret-key-at-least-32-chars

# Database & Runtime
# Use a Neon/PostgreSQL connection string for shared persistent data.
CIVICLENS_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require
CIVICLENS_DEMO_MODE=true
CIVICLENS_ADMIN_EMAIL=akshat.raj25@st.niituniversity.in

# Supabase Auth email/password login
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Server-only Supabase secret key used by FastAPI for Storage uploads.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
SUPABASE_REPORTS_BUCKET=civiclens-reports

# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
